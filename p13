#python program to find hcf or gcf
def calchcf(x,y):
    if x>y:
        smaller=y
    else:
        smaller=x
    for i in range(1,smaller+1):
        if((x%i==0)and(y%i==0)):
            hcf=i
    return hcf


print("the hcf of the given two number is: ",calchcf(12,30))            


