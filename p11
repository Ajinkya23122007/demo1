#pyhton program to find arm strong number in an interval
lower=int(input("enter a lower limit"))
upper=int(input("enter a upeer limit"))

for num in range(lower,upper+1):
    order=len(str(num))
    sum=0
    temp=num
    while temp>0:
        digit=temp%10
        sum=sum + digit ** order
        temp //=10
    if num==sum:
        print(num)

